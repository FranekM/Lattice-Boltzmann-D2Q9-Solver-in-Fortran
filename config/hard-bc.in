! ============================================================
! Closed Box experiments
! Bounce-back hard wall tests
! ============================================================


! ------------------------------------------- !
! Density pulse field animation in closed box !
! ------------------------------------------- !
&experiment
    cfg%family = "hard-bc"
    cfg%name   = "box-density-pulse-animation"

    cfg%Nx = 128
    cfg%Ny = 128
    cfg%Nt = 100
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/box_density_pulse.tsv"
    cfg%log%Nf   = 100

    ! Initial density: rho = 1 + eps*exp(-r^2/(2*sigma^2))
    cfg%rho%type = "gaussian"
    cfg%rho%gauss%val_0 = 1.0
    cfg%rho%gauss%eps   = 0.01
    cfg%rho%gauss%sigma = 10.0
    cfg%rho%gauss%xc = 96
    cfg%rho%gauss%yc = 96

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 1
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_places(1) = 255

    cfg%No = 1
    cfg%omegas = 1.0
/


! ----------------------------------------- !
! Density pulse field animation in the tube !
! ----------------------------------------- !
&experiment
    cfg%family = "hard-bc"
    cfg%name   = "tube-density-pulse-animation"

    cfg%Nx = 128
    cfg%Ny = 128
    cfg%Nt = 100
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/tube_density_pulse.tsv"
    cfg%log%Nf   = 100

    ! Initial density: rho = 1 + eps*exp(-r^2/(2*sigma^2))
    cfg%rho%type = "gaussian"
    cfg%rho%gauss%val_0 = 1.0
    cfg%rho%gauss%eps   = 0.01
    cfg%rho%gauss%sigma = 10.0
    cfg%rho%gauss%xc = 96
    cfg%rho%gauss%yc = 96

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "periodic"
    cfg%bc_places(1) = 5
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 10

    cfg%No = 1
    cfg%omegas = 1.0
/


! -------------------------------------- !
! The sliding lid cavity field animation !
! -------------------------------------- !
&experiment
    cfg%family = "hard-bc"
    cfg%name   = "sliding-lid-animation"

    cfg%Nx = 300
    cfg%Ny = 300
    cfg%Nt = 100000
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/sliding-lid-animation.tsv"
    cfg%log%Nf   = 50

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_post(1) = "moving_wall"
    cfg%bc_places(1) = 8
    cfg%bc_speed(1) = 0.1
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 7

    cfg%No = 1
    cfg%omegas = 1.7
/


! ---------------------------------------- !
! The 4-moving wall vortex field animation !
! ---------------------------------------- !
&experiment
    cfg%family = "hard-bc"
    cfg%name   = "4-moving-wall-animation"

    cfg%Nx = 100
    cfg%Ny = 100
    cfg%Nt = 2
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/4-moving-wall-animation.tsv"
    cfg%log%Nf   = 1

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_post(1) = "moving_wall"
    cfg%bc_places(1) = 6
    cfg%bc_speed(1) = 0.1
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_post(2) = "moving_wall"
    cfg%bc_places(2) = 9
    cfg%bc_speed(2) = -0.1

    cfg%No = 1
    cfg%omegas = 1.0
/
