! ============================================================
! Experiments with moving walls
! ============================================================


! -------------------------------------- !
! The sliding lid cavity field animation !
! -------------------------------------- !
&experiment
    cfg%family = "moving-walls"
    cfg%name   = "sliding-lid-animation"

    cfg%Nx = 300
    cfg%Ny = 300
    cfg%Nt = 100000
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/mw/sliding-lid-animation"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 5

    cfg%debug_step = 10000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_post(1) = "moving_wall"
    cfg%bc_places(1) = 8
    cfg%bc_speed(1) = 0.1
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 7

    cfg%No = 1
    cfg%omegas = 1.7
/


! ---------------------------------------- !
! The 4-moving wall vortex field animation !
! ---------------------------------------- !
&experiment
    cfg%family = "moving-walls"
    cfg%name   = "big-vortex-animation"

    cfg%Nx = 100
    cfg%Ny = 100
    cfg%Nt = 100000
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/mw/big_vortex_animation"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 5

    cfg%debug_step = 10000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_post(1) = "moving_wall"
    cfg%bc_places(1) = 6
    cfg%bc_speed(1) = 0.1
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_post(2) = "moving_wall"
    cfg%bc_places(2) = 9
    cfg%bc_speed(2) = -0.1

    cfg%No = 1
    cfg%omegas = 1.0
/
