! ============================================================
! Experiments with moving walls
! ============================================================


! -------------------------------- !
! The sliding lid and bottom field !
! -------------------------------- !
&experiment
    cfg%family = "moving-walls"
    cfg%name   = "v1-moving-walls"

    cfg%Nx = 300
    cfg%Ny = 300
    cfg%Nt = 150000
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/mw/v1_moving_walls"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 60

    cfg%debug_step = 10000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 3

    cfg%bc_list(1) 	 = "bounce_back"
    cfg%bc_post(1) 	 = "moving_wall"
    cfg%bc_places(1) = 8
    cfg%bc_speed(1)  = 0.1

    cfg%bc_list(2)   = "bounce_back"
    cfg%bc_post(2)   = "moving_wall"
    cfg%bc_places(2) = 2
    cfg%bc_speed(2)  = -0.1

    cfg%bc_list(3)   = "bounce_back"
    cfg%bc_places(3) = 5

    cfg%No = 1
    cfg%omegas = 1.7
/


! --------------------------------------- !
! The moving wall field animation !
! --------------------------------------- !
&experiment
    cfg%family = "moving-walls"
    cfg%name   = "v2-moving-walls"

    cfg%Nx = 300
    cfg%Ny = 300
    cfg%Nt = 250000
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/mw/v2_moving_walls"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 100

    cfg%debug_step = 10000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 4

    cfg%bc_list(1) = "bounce_back"
    cfg%bc_post(1) = "moving_wall"
    cfg%bc_places(1) = 4
    cfg%bc_speed(1) = 0.1

    cfg%bc_list(2) = "bounce_back"
    cfg%bc_post(2) = "moving_wall"
    cfg%bc_places(2) = 2
    cfg%bc_speed(2) = -0.1

    cfg%bc_list(3) = "bounce_back"
    cfg%bc_post(3) = "moving_wall"
    cfg%bc_places(3) = 8
    cfg%bc_speed(3) = 0.1

    cfg%bc_list(4) = "bounce_back"
    cfg%bc_post(4) = "moving_wall"
    cfg%bc_places(4) = 1
    cfg%bc_speed(4) = -0.1

    cfg%No = 1
    cfg%omegas = 1.7
/


