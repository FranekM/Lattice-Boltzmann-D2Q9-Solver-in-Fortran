! ============================================================
! Density pulses with different boundry conditions
! ============================================================


! ------------------------------------------- !
! Density pulse field animation in closed box !
! ------------------------------------------- !
&experiment
    cfg%family = "gaussian-wave-decay"
    cfg%name   = "box-density-pulse-animation"

    cfg%Nx = 128
    cfg%Ny = 128
    cfg%Nt = 200
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/gwd/box_animation"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 200

    cfg%debug_step = 100

    ! Initial density: rho = 1 + eps*exp(-r^2/(2*sigma^2))
    cfg%rho%type = "gaussian"
    cfg%rho%gauss%val_0 = 1.0
    cfg%rho%gauss%eps   = 0.01
    cfg%rho%gauss%sigma = 10.0
    cfg%rho%gauss%xc = 96
    cfg%rho%gauss%yc = 96

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 1
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_places(1) = 255

    cfg%No = 1
    cfg%omegas = 1.0
/


! ----------------------------------------- !
! Density pulse field animation in the tube !
! ----------------------------------------- !
&experiment
    cfg%family = "gaussian-wave-decay"
    cfg%name   = "tube-density-pulse-animation"

    cfg%Nx = 128
    cfg%Ny = 128
    cfg%Nt = 200
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/gwd/tube_animation"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 200

    cfg%debug_step = 100

    ! Initial density: rho = 1 + eps*exp(-r^2/(2*sigma^2))
    cfg%rho%type = "gaussian"
    cfg%rho%gauss%val_0 = 1.0
    cfg%rho%gauss%eps   = 0.01
    cfg%rho%gauss%sigma = 10.0
    cfg%rho%gauss%xc = 96
    cfg%rho%gauss%yc = 96

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "periodic"
    cfg%bc_places(1) = 5
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 10

    cfg%No = 1
    cfg%omegas = 1.0
/
