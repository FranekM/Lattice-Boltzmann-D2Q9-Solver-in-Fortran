! ============================================================
! Poiseuille Flow experiments
! ============================================================


! -------------------------!
! Velocity field animation !
! -------------------------!
&experiment
    cfg%family = "poiseuille-flow"
    cfg%name   = "pf-field-animation"

    cfg%Nx = 64
    cfg%Ny = 64
    cfg%Nt = 5000
    cfg%dpx = 0.001
    cfg%dpy = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/pf/field_animation"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 500

    cfg%debug_step = 1000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "periodic"
    cfg%bc_places(1) = 5
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 10

    cfg%No = 1
    cfg%omegas = 1.0
/


! ---------------- !
! Velocity profile !
! ---------------- !
&experiment
    cfg%family = "poiseuille-flow"
    cfg%name   = "pf-profile-snapshots"

    cfg%Nx = 300
    cfg%Ny = 300
    cfg%Nt = 200000
    cfg%dpx = 0.001
    cfg%dpy = 0.0

    cfg%log%type = "profile_y"
    cfg%log%file = "out/pf/profile_y_snapshots"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 5
    cfg%log%x    = 150

    cfg%debug_step = 10000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "periodic"
    cfg%bc_places(1) = 5
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 10

    cfg%No = 1
    cfg%omegas = 1.0

    cfg%disp_x = "y"
    cfg%disp_y = "ux"
/
