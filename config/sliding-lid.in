! ============================================================
! Sliding lid experiments
! ============================================================


! -------------------------------------- !
! The sliding lid cavity field animation !
! -------------------------------------- !
&experiment
    cfg%family = "sliding-lid"
    cfg%name   = "sliding-lid"

    cfg%Nx = 300
    cfg%Ny = 300
    cfg%Nt = 100000
    cfg%dpy = 0.0
    cfg%dpx = 0.0

    cfg%log%type = "field"
    cfg%log%file = "out/sl/sliding_lid"
    cfg%log%ext  = ".tsv"
    cfg%log%Nf   = 50

    cfg%debug_step = 10000

    cfg%rho%type = "constant"
    cfg%rho%const%value = 1.0

    cfg%ux%type = "constant"
    cfg%ux%const%value = 0.0

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 2
    cfg%bc_list(1) = "bounce_back"
    cfg%bc_post(1) = "moving_wall"
    cfg%bc_places(1) = 8
    cfg%bc_speed(1) = 0.1
    cfg%bc_list(2) = "bounce_back"
    cfg%bc_places(2) = 7

    cfg%No = 1
    cfg%omegas = 1.7
/