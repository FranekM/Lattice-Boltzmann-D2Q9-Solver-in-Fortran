    cfg%ux%sine%eps_y = 0.1
    cfg%ux%sine%mode_y = 1
    cfg%ux%sine%ny = 1

    cfg%uy%type = "constant"
    cfg%uy%const%value = 0.0

    cfg%bc_count = 1
