.PHONY: all dirs clean clean-out main fast

FC = ifx
FC_FLAGS = /nologo /Qcoarray /O3 /QxHost /Qipo /Qunroll

OUT_DIR = out\optim_2
OUT_DIRS =	       \
	$(OUT_DIR)	   \
	$(OUT_DIR)\1   \
	$(OUT_DIR)\4   \
	$(OUT_DIR)\9   \
	$(OUT_DIR)\16  \
	$(OUT_DIR)\25  \
	$(OUT_DIR)\36  \
	$(OUT_DIR)\49  \
	$(OUT_DIR)\64  \
	$(OUT_DIR)\81  \
	$(OUT_DIR)\100 \
	$(OUT_DIR)\121 \


SRC_DIR = src
BIN_DIR = bin
OBJ_DIR = $(BIN_DIR)\obj
MOD_DIR = $(BIN_DIR)\mods

TARGET  = $(BIN_DIR)\lbm.exe

SRC = 						  \
	$(SRC_DIR)/lbm_global.f90 \
	$(SRC_DIR)/lbm_solver.f90 \
	$(SRC_DIR)/lbm_logger.f90 \
	$(SRC_DIR)/lbm.f90

OBJ = $(SRC:$(SRC_DIR)/%.f90=$(OBJ_DIR)/%.obj)


all: dirs $(TARGET)

# create directories if not exist
dirs:
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	@if not exist "$(MOD_DIR)" mkdir "$(MOD_DIR)"
	@for %%d in ($(OUT_DIRS)) do if not exist "%%d" mkdir "%%d"

# Linking
$(TARGET): $(OBJ)
	$(FC) $(FC_FLAGS) $(OBJ) /exe:$@

# Compilation
$(OBJ_DIR)/%.obj: $(SRC_DIR)/%.f90
	$(FC) /module:$(MOD_DIR) $(FC_FLAGS) /c $< /object:$@

# Clear outputs
clean-out:
	@for %%d in ($(OUT_DIRS)) do del /Q "%%d\*"

# Remove build files
clean:
	- del /Q "$(OBJ_DIR)\*.obj"
	- del /Q "$(MOD_DIR)\*.mod"
	- del /Q "$(TARGET)"

print:
	@echo OBJ=$(OBJ)
	@echo OBJ_FAST=$(OBJ_FAST)