.PHONY: all clean run clean-out dirs

FC = ifx

OUT_DIR = out
OUT_DIRS = 			\
	$(OUT_DIR)		\
	$(OUT_DIR)\swd 	\
	$(OUT_DIR)\dwd 	\
	$(OUT_DIR)\gwd 	\
	$(OUT_DIR)\cf  	\
	$(OUT_DIR)\pf  	\
	$(OUT_DIR)\sl	\
	$(OUT_DIR)\mw

SRC_DIR = src
OBJ_DIR = bin\obj
MOD_DIR = bin\mods
BIN_DIR = bin

TARGET = $(BIN_DIR)\lbm.exe

FC_FLAGS = /nologo /module:$(MOD_DIR) /Qcoarray /O3 /QxHost /Qipo /Qunroll

SRC = 								\
	$(SRC_DIR)/lbm_types.f90 		\
	$(SRC_DIR)/lbm_consts.f90 		\
	$(SRC_DIR)/lbm_solver.f90 		\
	$(SRC_DIR)/lbm_bc.f90 			\
	$(SRC_DIR)/lbm_utils.f90		\
	$(SRC_DIR)/lbm_fields.f90 		\
	$(SRC_DIR)/lbm_loggers.f90 		\
	$(SRC_DIR)/lbm_simulation.f90 	\
	$(SRC_DIR)/lbm_config.f90 		\
	$(SRC_DIR)/lbm_faktory.f90 		\
	$(SRC_DIR)/lbm.f90

OBJ = $(SRC:$(SRC_DIR)/%.f90=$(OBJ_DIR)/%.obj)


all: dirs $(TARGET)

# create directories if not exist
dirs:
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	@if not exist "$(MOD_DIR)" mkdir "$(MOD_DIR)"
	@for %%d in ($(OUT_DIRS)) do if not exist "%%d" mkdir "%%d"

# Linking
$(TARGET): $(OBJ)
	$(FC) $(FC_FLAGS) $(OBJ) /exe:$@

# Compilation
$(OBJ_DIR)/%.obj: $(SRC_DIR)/%.f90
	$(FC) $(FC_FLAGS) /c $< /object:$@

# Remove build files
clean:
	del /Q $(OBJ_DIR)\*.obj
	del /Q $(MOD_DIR)\*.mod
	del /Q $(TARGET)

run: all
	$(TARGET)