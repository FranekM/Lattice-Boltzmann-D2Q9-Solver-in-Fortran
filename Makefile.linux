.PHONY: all clean run clean-out dirs

FC = ifx
FC_FLAGS = -coarray=distributed     \
           -free                    \
           -unroll					\
           -O3                      \

FC_FLAGS_2 = -coarray=distributed   \
			 -free                  \
             -O3                    \
             -xHost					\
             -ipo					\
             -unroll				\
             -ansi-alias


OUT_DIR = out/scaling
OUT_DIRS =  	   		\
	$(OUT_DIR)	   		\
	$(OUT_DIR)/9   		\
	$(OUT_DIR)/9/24   	\
	$(OUT_DIR)/18		\
	$(OUT_DIR)/18/24   	\


SRC_DIR = src
BIN_DIR = bin
OBJ_DIR = bin/obj
MOD_DIR = bin/mods
TARGET  = $(BIN_DIR)/lbm


SRC = $(SRC_DIR)/lbm.f90

OBJ = $(SRC:$(SRC_DIR)/%.f90=$(OBJ_DIR)/%.o)


all: dirs $(TARGET)

# Build directories if not exist
dirs:
	mkdir -p $(OBJ_DIR)
	mkdir -p $(MOD_DIR)
	mkdir -p $(OUT_DIRS)

# Linking
$(TARGET): $(OBJ)
	$(FC) $(FC_FLAGS) $(OBJ) -o $@

# Compilation
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.f90
	$(FC) -module $(MOD_DIR) $(FC_FLAGS) -c $< -o $@

# Clear outputs
clean-out:
	rm -rf $(OUT_DIR)/*

# Remove build files
clean:
	rm -f $(OBJ_DIR)/*.o
	rm -f $(MOD_DIR)/*.mod
	rm -f $(TARGET)

run: all
	./$(TARGET)