.PHONY: all clean run clean-out dirs

FC = ifx

OUT_DIR = out
OUT_DIRS = 			\
	$(OUT_DIR)		\
	$(OUT_DIR)/swd 	\
	$(OUT_DIR)/dwd 	\
	$(OUT_DIR)/gwd 	\
	$(OUT_DIR)/cf  	\
	$(OUT_DIR)/pf  	\
	$(OUT_DIR)/sl

SRC_DIR = src
OBJ_DIR = bin/obj
MOD_DIR = bin/mods
BIN_DIR = bin

TARGET = $(BIN)/lbm

FC_FLAGS = -module $(MOD_DIR)       \
           -coarray=distributed     \
           -free                    \
           -O3                      \
           -ipo                     \
           -unroll

SRC = 								\
	$(SRC_DIR)/lbm_types.f90 		\
	$(SRC_DIR)/lbm_consts.f90 		\
	$(SRC_DIR)/lbm_solver.f90 		\
	$(SRC_DIR)/lbm_bc.f90 			\
	$(SRC_DIR)/lbm_utils.f90		\
	$(SRC_DIR)/lbm_fields.f90 		\
	$(SRC_DIR)/lbm_loggers.f90 		\
	$(SRC_DIR)/lbm_simulation.f90 	\
	$(SRC_DIR)/lbm_config.f90 		\
	$(SRC_DIR)/lbm_faktory.f90 		\
	$(SRC_DIR)/lbm.f90

OBJ = $(SRC:$(SRC_DIR)/%.f90=$(OBJ_DIR)/%.o)


all: dirs $(TARGET)

dirs:
	mkdir -p $(OBJ_DIR)
	mkdir -p $(MOD_DIR)
	mkdir -p $(OUT_DIRS)

# Linking
$(TARGET): $(OBJ)
	$(FC) $(FC_FLAGS) $(OBJ) -o $@

# Compilation
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.f90
	$(FC) $(FC_FLAGS) -c $< -o $@

# Remove build files
clean:
	rm -f $(OBJ_DIR)/*.o
	rm -f $(MOD_DIR)/*.mod
	rm -f $(TARGET)

run: all
	./$(TARGET)