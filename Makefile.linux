.PHONY: all clean run clean_out dirs

FC = ifx
FC_FLAGS = -coarray=distributed     \
           -free                    \
           -O3                      \

FC_FLAGS_2 = -coarray=distributed   \
			 -free                  \
             -O3                    \
             -xHost					\
             -ipo					\
             -unroll				\
             -ansi-alias


OUT_FAST_DIRS =  \
	out/fast	 \
	out/fast/1   \
	out/fast/4   \
	out/fast/9   \
	out/fast/16  \
	out/fast/25  \
	out/fast/36  \
	out/fast/49  \
	out/fast/64  \
	out/fast/81  \
	out/fast/100 \
	out/fast/121


SRC_DIR = src
BIN_DIR = bin
OBJ_DIR = bin/obj
MOD_DIR = bin/mods
TARGET = lbm

SRC = 								\
	$(SRC_DIR)/lbm_types.f90 		\
	$(SRC_DIR)/lbm_consts.f90 		\
	$(SRC_DIR)/lbm_solver.f90 		\
	$(SRC_DIR)/lbm_bc.f90 			\
	$(SRC_DIR)/lbm_utils.f90		\
	$(SRC_DIR)/lbm_fields.f90 		\
	$(SRC_DIR)/lbm_loggers.f90 		\
	$(SRC_DIR)/lbm_simulation.f90 	\
	$(SRC_DIR)/lbm_config.f90 		\
	$(SRC_DIR)/lbm_faktory.f90 		\
	$(SRC_DIR)/lbm.f90

OBJ = $(SRC:$(SRC_DIR)/%.f90=$(OBJ_DIR)/%.o)


# OPTIMIZED (FAST) SLIDING LID

SRC_FAST_DIR = src/fast
BIN_FAST_DIR = bin/fast
OBJ_FAST_DIR = bin/fast/obj
MOD_FAST_DIR = bin/fast/mods
TARGET_FAST  = fast

SRC_FAST = 								\
	$(SRC_FAST_DIR)/lbm_fast_global.f90 \
	$(SRC_FAST_DIR)/lbm_fast_solver.f90 \
	$(SRC_FAST_DIR)/lbm_fast_logger.f90 \
	$(SRC_FAST_DIR)/lbm_fast.f90

OBJ_FAST = $(SRC_FAST:$(SRC_FAST_DIR)/%.f90=$(OBJ_FAST_DIR)/%.o)



all: dirs $(TARGET) $(TARGET_FAST)
fast: dirs $(TARGET_FAST)
main: dirs $(TARGET)


# Build directories if not exist
dirs:
	mkdir -p $(OBJ_DIR)
	mkdir -p $(MOD_DIR)
	mkdir -p $(OBJ_FAST_DIR)
	mkdir -p $(MOD_FAST_DIR)
	mkdir -p $(OUT_FAST_DIRS)


# Linking
$(TARGET): $(OBJ)
	$(FC) $(FC_FLAGS) $(OBJ) -o $@

# Compilation
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.f90
	$(FC) -module $(MOD_DIR) $(FC_FLAGS) -c $< -o $@


# Linking optimized (fast) version
$(TARGET_FAST): $(OBJ_FAST)
	$(FC) $(FC_FLAGS) $(OBJ_FAST) -o $@

# Compilation optimized (fast) version
$(OBJ_FAST_DIR)/%.o: $(SRC_FAST_DIR)/%.f90
	$(FC) -module $(MOD_FAST_DIR) $(FC_FLAGS) -c $< -o $@


clean_out:
	rm -rf out/fast/*

# Remove build files
clean:
	rm -f $(OBJ_DIR)/*.o
	rm -f $(MOD_DIR)/*.mod
	rm -f $(TARGET)
	rm -f $(OBJ_FAST_DIR)/*.o
	rm -f $(MOD_FAST_DIR)/*.mod
	rm -f $(TARGET_FAST)

run: all
	./$(TARGET)