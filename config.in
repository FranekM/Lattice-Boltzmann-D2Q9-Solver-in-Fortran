&experiment
    cfg%name        = "swd_amp_plots"
    cfg%type        = "swd"
    cfg%output      = "amp"
    cfg%Nx          = 100
    cfg%Ny          = 100
    cfg%n           = 1
    cfg%eps         = 0.01
    cfg%rho         = 1.0
    cfg%omegas      = 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75
    cfg%No          = 7
    cfg%Nt          = 1024
    cfg%frames      = 256
    cfg%filename    = "out/swd_amp_plots.tsv"
    cfg%disp_x      = "t"
    cfg%disp_y      = "A"
/

&experiment
    cfg%name        = "dwd_amp_plots"
    cfg%type        = "dwd"
    cfg%output      = "amp"
    cfg%Nx          = 100
    cfg%Ny          = 100
    cfg%n           = 1
    cfg%eps         = 0.01
    cfg%rho         = 1.0
    cfg%omegas      = 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75
    cfg%No          = 7
    cfg%Nt          = 1024
    cfg%frames      = 256
    cfg%filename    = "out/dwd_amp_plots.tsv"
    cfg%disp_x      = "t"
    cfg%disp_y      = "A"
/

